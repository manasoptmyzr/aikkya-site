---
import { Image } from 'astro:assets';
import logo from '../assets/aikkya-logo-website.png';
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<span class:list={['logo', className]}>
  <Image src={logo} alt="Aikkya · Seetla, Uttarakhand" widths={[160, 320, 640]} sizes="128px" format="webp" loading="eager" />
</span>
<style>
  .logo { display: inline-block; width: 8rem; flex-shrink: 0; mix-blend-mode: multiply; }
  .logo :global(img) { width: 100%; height: auto; }
</style>
