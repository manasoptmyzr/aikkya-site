---
import Logo from './Logo.astro';
import { site } from '../site';
const links = [
  { href: '/stay/', label: 'Stay' },
  { href: '/journal/', label: 'Life at Aikkya' },
  { href: '/us/', label: 'Us' },
  { href: '/kind-words/', label: 'Kind words' },
  { href: '/getting-here/', label: 'Getting here' },
  { href: '/say-hello/', label: 'Say hello' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="top">
  <a class="mark" href="/" aria-label="Aikkya home"><Logo /></a>
  <a class="ig" href={site.instagram} aria-label={`Aikkya on Instagram, ${site.instagramHandle}`}>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.3" cy="6.7" r="0.7" fill="currentColor" stroke="none" />
    </svg>
  </a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .mark :global(.logo) { display: block; width: 6rem; }
  .top { position: relative; }
  .ig {
    position: absolute;
    top: calc(var(--header-space) + 2rem);
    right: var(--gutter);
    display: flex;
    padding: 0.4rem;
    margin: -0.4rem;
    color: var(--ink);
  }
  .ig:hover { color: var(--rug); }
  .ig svg { display: block; }
</style>
