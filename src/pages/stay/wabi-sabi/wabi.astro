---
import Base from '../../../layouts/Base.astro';
import SuiteGallery from '../../../components/SuiteGallery.astro';
import { wabiGroups } from '../../../data/wabi-gallery';
---
<Base title="Wabi" description="Photographs of Wabi at Aikkya in Seetla, Kumaon: the bedroom, furniture, room details and bathroom.">
  <div class="suite-heading"><h1>Wabi</h1></div>
  <SuiteGallery groups={wabiGroups} />
</Base>
<style>
  .suite-heading { padding: 0.75rem var(--gutter) 1.75rem; text-align: center; }
  h1 { margin: 0; font-family: 'TC Jimmy Serif Pro', var(--serif); font-weight: 700; font-size: clamp(2rem, 1.5rem + 1.5vw, 2.75rem); }
</style>
