---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Seam from '../components/Seam.astro';
import RoomCards from '../components/RoomCards.astro';
import { site, rupees, whatsappLink } from '../site';
import { lodging } from '../schema';

const rooms = (await getCollection('rooms')).sort((a, b) => a.data.order - b.data.order);
const p = site.prices;
---
<Base
  title={site.showPrices ? 'Rooms and prices' : 'Rooms'}
  description={`Where you'd stay at Aikkya: Kintsugi, A-Frame of Mind, and the Wabi and Sabi suites.${site.showPrices ? ` ${rupees(p.wabiSabi)} to ${rupees(p.kintsugi)} a night for two, with breakfast.` : ' Breakfast is included.'}`}
  schema={lodging(rooms.map((r) => r.data))}
>
  <RoomCards />

  <Seam />

  <section class="text">
    <p><a class="say" href={whatsappLink()}>Write to us on WhatsApp</a></p>
  </section>
</Base>
