---
import Base from '../layouts/Base.astro';
import Seam from '../components/Seam.astro';
import Press from '../components/Press.astro';
import GuestReviews from '../components/GuestReviews.astro';
---
<Base title="Guestbook" description="Read our guests’ Google and Airbnb reviews of staying at Aikkya with Shivani and Avijeet, and find Aikkya in the news.">
  <div class="text page-head">
    <h1>Guestbook</h1>
  </div>
  <div class="wide guestbook-reviews">
    <GuestReviews />
  </div>
  <Seam />
  <section class="text" id="news">
    <h2>In the news</h2>
    <Press />
  </section>
</Base>
<style>
  .guestbook-reviews :global(.guest-reviews) { margin-top: 1.5rem; }
</style>
