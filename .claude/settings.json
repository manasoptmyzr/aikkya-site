{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/Downloads"
    ],
    "allow": [
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(file:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git push)",
      "Bash(git revert:*)",
      "Bash(git status)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run dev:*)",
      "Bash(npx astro:*)",
      "Bash(sips:*)",
      "Bash(tail:*)",
      "Read(~/Downloads/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
